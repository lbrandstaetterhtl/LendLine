DATABASE_URL=postgresql://lendline:lendline@localhost:5432/lendline
# Mindestens 32 zufällige Zeichen, z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mit dem Platzhalter startet die API nur außerhalb von NODE_ENV=production (mit Warnung).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LendLine <noreply@lendline.local>

# LDAP ist aktiv, sobald LDAP_URL und LDAP_BASE_DN gesetzt sind.
# Ohne Werte bleibt die lokale Anmeldung (Demo-Konten) unverändert.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(|(mail={{username}})(sAMAccountName={{username}})(uid={{username}}))
LDAP_ADMIN_GROUP=
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_NAME=displayName
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_ALLOW_LOCAL_REGISTER=true
