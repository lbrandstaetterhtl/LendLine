DATABASE_URL=postgresql://lendline:lendline@localhost:5432/lendline
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The API does not start with the placeholder; shorter values only in development (with a warning).
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
# A session ends at the latest this many days after sign-in, even while it is in use.
SESSION_MAX_DAYS=30
JWT_REFRESH_TTL_DAYS=7
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LendLine <noreply@lendline.local>

# LDAP is active as soon as LDAP_URL and LDAP_BASE_DN are set.
# Without values the local sign-in (demo accounts) stays as it is.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(|(mail={{username}})(sAMAccountName={{username}})(uid={{username}}))
# Full group DNs, several separated by ;, e.g. CN=LendLine-Admins,OU=Groups,DC=company,DC=com
LDAP_ADMIN_GROUP=
# Only with ldaps:// and a verified certificate. Otherwise the start aborts in production, unless:
LDAP_ALLOW_INSECURE=false
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_NAME=displayName
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_ALLOW_LOCAL_REGISTER=true
