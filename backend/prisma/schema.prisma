generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthSource {
  LOCAL
  LDAP
}

enum DeviceStatus {
  AVAILABLE
  BORROWED
  DEFECTIVE
}

enum RequestStatus {
  OPEN
  APPROVED
  REJECTED
  RETURNED
  /// Withdrawn by the requester before a decision.
  CANCELLED
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String?
  authSource         AuthSource      @default(LOCAL)
  ldapDn             String?         @unique
  /// Every user belongs to exactly one group; its permissions decide what the user may do.
  groupId            String
  group              Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())
  /// Raised on revocation, password reset and group change; access tokens carry it as `sv`.
  sessionVersion     Int             @default(0)
  /// Set when an admin chose the password: the user must pick their own at the next login.
  mustChangePassword Boolean         @default(false)
  /// Language of the interface and the e-mails ("de", "en", "es", "zh", "hi"); null = German.
  locale             String?
  requests           BorrowRequest[]
  refreshTokens      RefreshToken[]

  @@index([groupId])
}

/// A set of permissions (keys from backend/src/lib/permissions.ts) plus optional limits.
model Group {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String   @default("")
  permissions       String[] @default([])
  /// Categories the members may borrow from; empty = all.
  borrowCategoryIds String[] @default([])
  /// Categories whose requests, loans and devices the members manage; empty = all.
  manageCategoryIds String[] @default([])
  /// Loan rules for this group; null = the company-wide setting.
  maxDays           Int?
  maxOpenPerUser    Int?
  autoApprove       Boolean?
  /// Directory groups (full DNs) whose members get this group at login.
  ldapGroupDns      String[] @default([])
  /// New accounts (registration, first directory login) land here; exactly one group has it.
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  users             User[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  devices Device[]
}

model Device {
  id          String          @id @default(cuid())
  name        String
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  description String          @default("")
  /// Free properties of the model, e.g. [{ name: "RAM", value: "16 GB" }].
  fields      Json            @default("[]")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  requests    BorrowRequest[]
  images      DeviceImage[]
  units       DeviceUnit[]
}

model Room {
  id          String          @id @default(cuid())
  name        String          @unique
  building    String          @default("")
  description String          @default("")
  requests    BorrowRequest[]
}

model DeviceUnit {
  id           String          @id @default(cuid())
  deviceId     String
  serialNumber String          @unique
  status       DeviceStatus    @default(AVAILABLE)
  device       Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requests     BorrowRequest[]

  @@index([deviceId])
  @@index([status])
}

model DeviceImage {
  id        String   @id @default(cuid())
  deviceId  String
  fileName  String
  createdAt DateTime @default(now())
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

model BorrowRequest {
  id              String        @id @default(cuid())
  userId          String
  deviceId        String
  unitId          String?
  roomId          String
  status          RequestStatus @default(OPEN)
  requestedAt     DateTime      @default(now())
  startsAt        DateTime
  desiredUntil    DateTime
  approvedAt      DateTime?
  returnedAt      DateTime?
  comment         String        @default("")
  rejectionReason String        @default("")
  cancelledAt     DateTime?
  /// Answers to the company's own form fields, as [{ label, value }] at the time of the request.
  fields          Json          @default("[]")
  user            User          @relation(fields: [userId], references: [id])
  device          Device        @relation(fields: [deviceId], references: [id])
  unit            DeviceUnit?   @relation(fields: [unitId], references: [id])
  room            Room          @relation(fields: [roomId], references: [id])

  @@index([userId])
  @@index([deviceId])
  @@index([status])
}

model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorName  String
  action     String
  entityType String
  entityId   String?
  summary    String
  /// Structured detail: { changes?: [{ field, from, to }], context?: { label: value } }
  details    Json?
  ip         String?
  userAgent  String?

  @@index([createdAt])
  @@index([action])
  @@index([entityType])
  @@index([actorId])
}

/// Runtime settings changed from the admin UI, e.g. key "maintenance".
model SystemSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model RefreshToken {
  id               String    @id @default(cuid())
  userId           String
  tokenHash        String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  /// Login time of the session; carried over on every rotation to cap its total lifetime.
  sessionStartedAt DateTime  @default(now())
  /// Set when the token was replaced by rotation (not by logout or an admin); presenting it again
  /// later means it was copied.
  rotatedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
