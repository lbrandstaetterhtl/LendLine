{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "jsdoc",
    "node",
    "promise",
    "oxc"
  ],
  "env": {
    "node": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-console": [
      "error",
      {
        "allow": ["warn", "error", "info"]
      }
    ],
    // `_count` / `_all` are Prisma's aggregation API and cannot be renamed.
    "no-underscore-dangle": ["error", { "allow": ["_count", "_all"] }],
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "no-duplicate-imports": "off",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/promise-function-async": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "minimumDescriptionLength": 10
      }
    ],
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/consistent-type-exports": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "import/no-cycle": "error",
    "import/no-named-export": "off",
    "import/group-exports": "off",
    "import/first": "off",
    "import/exports-last": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "error",
    "no-useless-assignment": "error",
    "jsdoc/check-tag-names": "error",
    "promise/always-return": "error",
    "promise/catch-or-return": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-promise-in-callback": "error",
    "promise/no-callback-in-promise": "error",
    "promise/valid-params": "error",
    "promise/no-new-statics": "error",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-callbacks": "off",
    "promise/prefer-await-to-then": "off",
    "promise/no-return-in-finally": "error",
    "node/handle-callback-err": "error",
    "node/no-new-require": "error",
    "node/no-path-concat": "error",
    "node/no-process-env": "error",
    "node/global-require": "error",
    "node/no-exports-assign": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-null": "off",
    "unicorn/prefer-module": "off",
    "unicorn/no-anonymous-default-export": "off",
    "unicorn/filename-case": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-throw-literal": "error",
    "no-self-compare": "error",
    "array-callback-return": "error",
    "no-fallthrough": "error",
    "radix": "error",
    "no-constructor-return": "error",
    "no-useless-return": "error",
    "no-lonely-if": "error",
    "no-unneeded-ternary": "error",
    "no-useless-concat": "error",
    "no-useless-constructor": "error",
    "default-param-last": "error",
    "default-case-last": "error",
    "preserve-caught-error": "error",
    "unicorn/error-message": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/no-instanceof-array": "error",
    "unicorn/no-array-fill-with-reference-type": "error",
    "unicorn/prefer-array-flat-map": "error",
    "oxc/no-async-endpoint-handlers": "off",
    "oxc/no-accumulating-spread": "error",
    "oxc/no-map-spread": "off",
    "no-await-in-loop": "off",
    "typescript/no-deprecated": "error",
    "typescript/no-base-to-string": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/require-array-sort-compare": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "off",
    "typescript/restrict-template-expressions": "off",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/bad-bitwise-operator": "error",
    "oxc/bad-char-at-comparison": "error",
    "oxc/bad-comparison-sequence": "error",
    "oxc/bad-min-max-func": "error",
    "oxc/bad-object-literal-comparison": "error",
    "oxc/bad-replace-all-arg": "error",
    "oxc/const-comparisons": "error",
    "oxc/double-comparisons": "error",
    "oxc/erasing-op": "error",
    "oxc/misrefactored-assign-op": "error",
    "oxc/missing-throw": "error",
    "oxc/number-arg-out-of-range": "error",
    "oxc/only-used-in-recursion": "error",
    "oxc/uninvoked-array-callback": "error",
    "oxc/approx-constant": "error",
    "oxc/no-this-in-exported-function": "error",
    "typescript/await-thenable": "error",
    "typescript/no-for-in-array": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-misused-new": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-duplicate-enum-values": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-useless-empty-export": "error",
    "typescript/prefer-as-const": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/no-unsafe-declaration-merging": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/unified-signatures": "error",
    "typescript/no-this-alias": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-import-type-side-effects": "error",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "unicorn/no-thenable": "error",
    "unicorn/no-unnecessary-await": "error",
    "unicorn/no-await-in-promise-methods": "error",
    "unicorn/no-single-promise-in-promise-methods": "error",
    "unicorn/no-new-buffer": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/no-useless-promise-resolve-reject": "error",
    "unicorn/consistent-date-clone": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/no-useless-fallback-in-spread": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/require-array-join-separator": "error",
    "unicorn/prefer-structured-clone": "error",
    "promise/no-return-wrap": "error",
    "promise/no-nesting": "error",
    "promise/prefer-catch": "error",
    "promise/spec-only": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-empty-named-blocks": "error",
    "import/no-named-default": "error",
    "import/no-absolute-path": "error",
    "import/no-mutable-exports": "error",
    "unicorn/no-typeof-undefined": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/consistent-existence-index-check": "error",
    // In LendLine "" means "not set" (Prisma @default(""), empty query params, "all categories"),
    // so `||` on strings is intentional; the rule stays on for every other type.
    "typescript/prefer-nullish-coalescing": [
      "error",
      { "ignorePrimitives": { "string": true } }
    ],
    "typescript/require-await": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-slice": "error",
    "import/consistent-type-specifier-style": "off",
    "typescript/prefer-regexp-exec": "error",
    "promise/param-names": "warn",
    "node/callback-return": "warn",
    "typescript/return-await": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "unicorn/prefer-math-min-max": "error",
    "unicorn/prefer-math-trunc": "warn",
    "unicorn/prefer-code-point": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/prefer-native-coercion-functions": "warn",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-set-has": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "uploads/**",
    "**/*.js",
    "**/*.mjs"
  ],
  "overrides": [
    {
      // config.ts is the single place that reads environment variables; everything else imports
      // the typed `config` object.
      "files": ["src/config.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    }
  ]
}
