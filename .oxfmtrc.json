{
  "$schema": "./backend/node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "bracketSpacing": true,
  "arrowParens": "always",
  "jsdoc": {
    "commentLineStrategy": "multiline",
    "capitalizeDescriptions": true
  },
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "value-internal",
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ],
    "newlinesBetween": true
  },
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "**/*.md",
    "**/migrations/**",
    "**/uploads/**",
    "**/*.json",
    "**/*.jsonc",
    "**/*.yml",
    "**/*.yaml"
  ]
}
